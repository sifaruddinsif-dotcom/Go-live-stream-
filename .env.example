# Required in the separate Render API service
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Comma-separated browser origins, e.g. https://go-live-stream-app.onrender.com
ALLOWED_ORIGINS=https://go-live-stream-app.onrender.com
NODE_ENV=production
