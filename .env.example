# Required in the separate Render API service
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Comma-separated browser origins, e.g. https://go-live-stream-app.onrender.com
ALLOWED_ORIGINS=https://go-live-stream-app.onrender.com
NODE_ENV=production

# LiveKit Cloud project (create at https://cloud.livekit.io/)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Razorpay account (activate and obtain keys in dashboard)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
